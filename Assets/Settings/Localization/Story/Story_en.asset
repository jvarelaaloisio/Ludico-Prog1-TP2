  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Story_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 46725f6241d844d4c8841f278bd2f6dd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 18432060776448
    m_Localized: They are among us! Those demons! They are invading us, destroying
      our neighborhoods, our houses, our Culture! We must stop them. No matter the
      cost!
    m_Metadata:
      m_Items: []
  - m_Id: 19297828036608
    m_Localized: Hey, George. Are you listening?
    m_Metadata:
      m_Items: []
  - m_Id: 19252969955328
    m_Localized: The neighbor keeps asking if we've seen her missing hens. I told
      her we would help her in the morning. We should divide out the places they
      could...
    m_Metadata:
      m_Items: []
  - m_Id: 25951617376256
    m_Localized: I've said it once and I'll say it again! Those demons must go! We
      must defend our religious superiority, people!
    m_Metadata:
      m_Items: []
  - m_Id: 25994625769472
    m_Localized: Those chickens! Did you actually have to kill them all? What's going
      on? I've never seen you act this way!
    m_Metadata:
      m_Items: []
  - m_Id: 26017673469952
    m_Localized: Tomorrow morning we're knocking on her door and apologizing. We
      must make it up to her for this mess!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
