MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Story_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 46725f6241d844d4c8841f278bd2f6dd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 18432060776448
    m_Localized: "\xA1Nos invaden los demonios! Nos invaden y destruyen nuestros
      barrios, nuestras casas, \xA1nuestra Cultura! Hay que detenerlos. \xA1no importa
      el costo!"
    m_Metadata:
      m_Items: []
  - m_Id: 19252969955328
    m_Localized: "La vecina sigue preguntando por sus gallinas desaparecidas. Le
      dije que la ayudar\xEDamos como pudieramos. Tenemos que repartirnos los lugares..."
    m_Metadata:
      m_Items: []
  - m_Id: 19297828036608
    m_Localized: "Ra\xFAl, \xBFme estas escuchando?"
    m_Metadata:
      m_Items: []
  - m_Id: 25994625769472
    m_Localized: "\xA1Las gallinas! \xBFTantas ten\xEDas que matar? \xBFQu\xE9 te
      est\xE1 pasando? \xA1Nunca te hab\xEDa visto comportarte as\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 26017673469952
    m_Localized: "\xA1Ma\xF1ana, por la ma\xF1ana, le tocamos la puerta a la vecina
      para pedirle perd\xF3n y compensarla por este mamarracho!"
    m_Metadata:
      m_Items: []
  - m_Id: 25951617376256
    m_Localized: "Lo he dicho y lo seguir\xE9 diciendo. \xA1Esos demonios deben desaparecer!\n\xA1Debemos
      defender nuestra superioridad religiosa!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
